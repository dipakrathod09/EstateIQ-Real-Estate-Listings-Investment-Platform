# PostgreSQL Database Configuration
POSTGRES_DB=estateiq_db
POSTGRES_USER=estateiq_user
POSTGRES_PASSWORD=estateiq_pass_secret
DATABASE_URL=postgres://estateiq_user:estateiq_pass_secret@db:5432/estateiq_db

# Django Core Secrets & Settings
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend Configuration
VITE_API_URL=http://localhost:8000
ML_SERVICE_URL=http://ml-service:8001

# AWS S3 Storage Credentials (Optional in local dev)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-placeholder
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-placeholder
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name-placeholder
AWS_S3_REGION_NAME=us-east-1

# Razorpay Integration Keys (Optional in local dev)
RAZORPAY_KEY_ID=rzp_test_your_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_placeholder
